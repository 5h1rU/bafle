{
  "name": "bafle",
  "version": "0.0.0",
  "private": true,
  "description": "A music player that keeps its music provider behind an Effect service.",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "typecheck": "tsc -b",
    "test": "pnpm -r --filter './packages/*' test"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/domain": "catalog:",
    "@bafle/domain": "workspace:*",
    "@bafle/server": "workspace:*",
    "@bafle/web": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-browser": "catalog:",
    "@effect/platform-node": "catalog:",
    "@foldkit/vite-plugin": "catalog:",
    "foldkit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
