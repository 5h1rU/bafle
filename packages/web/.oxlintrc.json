{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../../.oxlintrc.base.json",
    "../../node_modules/@foldkit/oxlint-plugin/recommended.json"
  ],
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "**/*.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "public/"
  ],
  "overrides": [
    {
      "files": [
        "test/**/*.ts"
      ],
      "rules": {
        "foldkit/no-child-message-construction-in-root": "off",
        "foldkit/no-disabling-dev-guardrails": "off"
      }
    }
  ]
}
